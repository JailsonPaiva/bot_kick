{
  "name": "kick-bot",
  "version": "4.0.0",
  "description": "Bot Kick.com — OAuth 2.1 + Mini Games + API REST",
  "type": "module",
  "main": "dist/bot.js",
  "scripts": {
    "dev": "tsx src/bot.ts",
    "build": "tsc",
    "start": "node dist/bot.js",
    "test": "tsx --test src/games/ttt/tttGame.test.ts src/commands/parser.test.ts src/commands/customCommands.test.ts src/moderation/moderationService.test.ts src/timers/timerService.test.ts src/api/routes/phase2Routes.test.ts src/kick/webhookSignature.test.ts src/api/routes/kickWebhooks.test.ts src/api/openapi/spec.test.ts",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "kick",
    "bot",
    "oauth",
    "chat",
    "minigames",
    "api",
    "dashboard"
  ],
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "open": "^10.1.0",
    "pg": "^8.16.0",
    "socket.io": "^4.7.5",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.14",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.5.13",
    "prisma": "^7.8.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
