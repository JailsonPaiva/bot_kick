{
  "name": "kick-bot",
  "version": "3.0.0",
  "description": "Bot Kick.com — OAuth 2.1 + Mini Games + API REST + Dashboard Web",
  "type": "module",
  "main": "dist/bot.js",
  "scripts": {
    "dev": "tsx src/bot.ts",
    "dev:web": "cd web && npm run dev",
    "build": "tsc && node scripts/copy-migrations.mjs",
    "build:web": "cd web && npm run build",
    "start": "node dist/bot.js",
    "test": "tsx --test src/games/ttt/tttGame.test.ts src/db/repositories/repositories.test.ts src/games/engine/gameManager.recover.test.ts src/commands/parser.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": ["kick", "bot", "oauth", "chat", "minigames", "api", "dashboard"],
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.8.1",
    "cors": "^4.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "open": "^10.1.0",
    "socket.io": "^4.7.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
