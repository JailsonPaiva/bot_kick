# Credenciais do app Kick (https://kick.com/settings/developer)
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# Slug do canal onde o bot vai operar — copie da URL: kick.com/<este-valor>
KICK_CHANNEL_SLUG=

# Slug da conta do bot (para ignorar as próprias mensagens)
KICK_BOT_SLUG=

# ID numérico do chatroom (obrigatório se a API retornar 403 no Node)
# Obtenha no browser: https://kick.com/api/v2/channels/<KICK_CHANNEL_SLUG>
KICK_CHATROOM_ID=
