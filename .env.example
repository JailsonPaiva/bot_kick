# Credenciais do app Kick (https://kick.com/settings/developer)
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# Slug do canal onde o bot vai operar — copie da URL: kick.com/<este-valor>
KICK_CHANNEL_SLUG=

# Slug da conta do bot (para ignorar as próprias mensagens)
KICK_BOT_SLUG=

# ID numérico do chatroom (obrigatório se a API retornar 403 no Node)
# Obtenha no browser: https://kick.com/api/v2/channels/<KICK_CHANNEL_SLUG>
KICK_CHATROOM_ID=

# --- Fase 2: jogos e ranking (opcional) ---
# DATABASE_PATH=data/bot.db
# GAME_TIMEOUT_MS=300000
# COMMAND_COOLDOWN_MS=2000
# MAX_ACTIVE_GAMES=1
# BOT_MESSAGE_PREFIX=true
# RECOVER_GAMES_ON_BOOT=true

# --- Fase 3: API REST (frontend em repositório separado) ---
# API_PORT=3001
# CORS_ORIGIN=http://localhost:3000
# API_JWT_SECRET=change-me-in-production
# ADMIN_PASSWORD_HASH=
# WEB_PLAY_URL=http://localhost:3000/play
# WEB_OVERLAY_URL=http://localhost:3000/overlay
# PLAYER_TOKEN_EXPIRY=10m
# OVERLAY_TOKEN_EXPIRY=30d
# LOYALTY_POINTS_PER_ACTIVITY=1
# LOYALTY_ACTIVITY_INTERVAL_SECONDS=60
# (defaults ao criar LoyaltyConfig; ajuste fino via dashboard GET/PUT /api/loyalty/config)

# --- Chat webhook oficial Kick (Events API) ---
# URL pública do backend (tunnel/produção) — usada na Parte 2 do guia
# PUBLIC_API_URL=https://xxx.trycloudflare.com
# KICK_WEBHOOK_PATH=/api/kick/webhooks/events
# KICK_WEBHOOK_SKIP_VERIFY=false
# KICK_WEBHOOK_PUBLIC_KEY=   # opcional; padrão busca GET /public/v1/public-key
# Scopes moderação (Parte 9): moderation:ban, moderation:chat_message:manage — refaça auth:relogin após marcar no portal

# --- Fase 4: giveaway e polls ---
# GIVEAWAY_DEFAULT_FILTER=everyone
# POLL_DEFAULT_DURATION_SECONDS=60
# Para gerar o hash da senha: node -e "const bcrypt = require('bcryptjs'); bcrypt.hash('sua-senha', 10).then(console.log)"

# --- Base de escala (PostgreSQL + Redis + Prisma) ---
# DATABASE_URL=postgresql://kick_bot:kick_bot@localhost:5432/kick_bot?schema=public
# REDIS_URL=redis://localhost:6379
