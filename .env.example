# Credenciais do app Kick (https://kick.com/settings/developer)
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# Slug do canal onde o bot vai operar — copie da URL: kick.com/<este-valor>
KICK_CHANNEL_SLUG=

# Slug da conta do bot (para ignorar as próprias mensagens)
KICK_BOT_SLUG=

# ID numérico do chatroom (obrigatório se a API retornar 403 no Node)
# Obtenha no browser: https://kick.com/api/v2/channels/<KICK_CHANNEL_SLUG>
KICK_CHATROOM_ID=

# --- Fase 2: jogos e ranking (opcional) ---
# DATABASE_PATH=data/bot.db
# GAME_TIMEOUT_MS=300000
# COMMAND_COOLDOWN_MS=2000
# MAX_ACTIVE_GAMES=1
# BOT_MESSAGE_PREFIX=true
# RECOVER_GAMES_ON_BOOT=true

# --- Fase 3: API REST e Dashboard Web ---
# API_PORT=3001
# CORS_ORIGIN=http://localhost:5173
# API_JWT_SECRET=change-me-in-production
# ADMIN_PASSWORD_HASH=
# WEB_PLAY_URL=http://localhost:5173/play
# WEB_OVERLAY_URL=http://localhost:5173/overlay
# PLAYER_TOKEN_EXPIRY=10m
# OVERLAY_TOKEN_EXPIRY=30d
# LOYALTY_POINTS_PER_ACTIVITY=1
# LOYALTY_ACTIVITY_INTERVAL_SECONDS=60
# Para gerar o hash da senha: node -e "const bcrypt = require('bcryptjs'); bcrypt.hash('sua-senha', 10).then(console.log)"

# --- Base de escala (PostgreSQL + Redis + Prisma) ---
# DATABASE_URL=postgresql://kick_bot:kick_bot@localhost:5432/kick_bot?schema=public
# REDIS_URL=redis://localhost:6379
