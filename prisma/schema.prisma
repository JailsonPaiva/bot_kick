generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Modelos de canal e sessão (Fase 1 — multi-channel futuro) ───────────────

model Channel {
  id                  String       @id @default(uuid())
  kickChannelId       String       @unique
  slug                String       @unique
  kickAccessTokenEnc  String
  kickRefreshTokenEnc String?
  tokenExpiresAt      DateTime?
  botPrefix           String       @default("!")
  timezone            String       @default("UTC")
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  sessions            BotSession[]
}

model User {
  id          String   @id @default(uuid())
  kickUserId  String   @unique
  username    String
  displayName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BotSession {
  id          String   @id @default(uuid())
  channelId   String
  status      String
  connectedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  channel     Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, status])
}

// ─── Fase 2 — Comandos customizáveis ─────────────────────────────────────────

model Command {
  id          String   @id @default(uuid())
  channelSlug String
  trigger     String
  aliases     String[]
  response    String
  permission  String   @default("everyone")
  cooldown    Int      @default(5)
  usageCount  Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([channelSlug, trigger])
  @@index([channelSlug, isActive])
}

model SystemCommandConfig {
  id          String   @id @default(uuid())
  channelSlug String
  trigger     String
  response    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([channelSlug, trigger])
  @@index([channelSlug, isActive])
}

// ─── Fase 2 — Timers ─────────────────────────────────────────────────────────

model Timer {
  id              String   @id @default(uuid())
  channelSlug     String
  name            String
  messages        String[]
  intervalMinutes Int      @default(30)
  minViewers      Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([channelSlug, isActive])
}

// ─── Fase 2 — Moderação ───────────────────────────────────────────────────────

model ModerationConfig {
  id             String   @id @default(uuid())
  channelSlug    String   @unique
  linksEnabled   Boolean  @default(false)
  linksWhitelist String[]
  linksActionType String  @default("warn")
  linksTimeoutDurationMinutes Int @default(1)
  capsEnabled    Boolean  @default(false)
  capsPercent    Int      @default(70)
  capsActionType String   @default("warn")
  capsTimeoutDurationMinutes Int @default(1)
  spamEnabled    Boolean  @default(false)
  spamWindow     Int      @default(5)
  spamActionType String   @default("warn")
  spamTimeoutDurationMinutes Int @default(1)
  bannedWords    String[]
  bannedActionType String @default("warn")
  bannedTimeoutDurationMinutes Int @default(1)
  actionType     String   @default("warn")
  timeoutDurationMinutes Int @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ModerationLog {
  id          String   @id @default(uuid())
  channelSlug String
  userId      Int
  username    String
  messageId   String
  content     String
  reason      String
  action      String
  createdAt   DateTime @default(now())

  @@index([channelSlug, createdAt])
}

// ─── Fase 3 — Loyalty points e alertas ───────────────────────────────────────

model LoyaltyConfig {
  id                     String   @id @default(uuid())
  channelSlug            String   @unique
  chatEnabled            Boolean  @default(true)
  pointsPerChatActivity  Int      @default(1)
  chatIntervalSeconds    Int      @default(60)
  memberMultiplier       Float    @default(1)
  memberBonusFlat        Int      @default(0)
  eventFollowEnabled     Boolean  @default(false)
  eventFollowPoints      Int      @default(0)
  eventSubscriptionEnabled Boolean @default(false)
  eventSubscriptionPoints  Int    @default(0)
  eventGiftSubEnabled    Boolean  @default(false)
  eventGiftSubPoints     Int      @default(0)
  eventRaidEnabled       Boolean  @default(false)
  eventRaidPoints        Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model ViewerPoints {
  id         String   @id @default(uuid())
  channelSlug String
  kickUserId BigInt
  username   String
  slug       String
  balance    Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([channelSlug, kickUserId])
  @@index([channelSlug, balance])
}

model PointTransaction {
  id          String   @id @default(uuid())
  channelSlug String
  kickUserId  BigInt
  amount      Int
  type        String
  reason      String?
  createdAt   DateTime @default(now())

  @@index([channelSlug, kickUserId, createdAt])
}

model StoreItem {
  id              String   @id @default(uuid())
  channelSlug     String
  code            String
  title           String
  description     String?
  costPoints      Int
  stock           Int?
  cooldownSeconds Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([channelSlug, code])
  @@index([channelSlug, isActive, createdAt])
}

model StoreRedemption {
  id          String   @id @default(uuid())
  channelSlug String
  itemId      String
  itemCode    String
  itemTitle   String
  kickUserId  BigInt
  username    String
  slug        String
  quantity    Int      @default(1)
  totalCost   Int
  createdAt   DateTime @default(now())

  @@index([channelSlug, createdAt])
  @@index([channelSlug, kickUserId, createdAt])
  @@index([itemId, createdAt])
}

model AlertConfig {
  id          String   @id @default(uuid())
  channelSlug String
  type        String
  isActive    Boolean  @default(true)
  imageUrl    String?
  message     String?
  durationMs  Int      @default(5000)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([channelSlug, type])
}

model WatchSession {
  id           String    @id @default(uuid())
  channelSlug  String
  kickUserId   BigInt
  username     String
  startedAt    DateTime
  endedAt      DateTime?
  pointsEarned Int       @default(0)
  createdAt    DateTime  @default(now())

  @@index([channelSlug, kickUserId, startedAt])
}

// ─── Fase 4 — Giveaways, polls e ranking público ────────────────────────────

model Giveaway {
  id               String          @id @default(uuid())
  channelSlug      String
  prize            String
  filterType       String          @default("everyone")
  costPoints       Int             @default(0)
  weightedSubs     Boolean         @default(false)
  entryMode        String          @default("command")
  entryCommand     String          @default("entrar")
  entryDurationSeconds Int         @default(60)
  entryEndsAt      DateTime?
  status           String          @default("open")
  winnerKickUserId BigInt?
  createdAt        DateTime        @default(now())
  closedAt         DateTime?
  entries          GiveawayEntry[]

  @@index([channelSlug, status, createdAt])
}

model GiveawayEntry {
  id         String   @id @default(uuid())
  giveawayId String
  kickUserId BigInt
  username   String
  slug       String
  weight     Int      @default(1)
  createdAt  DateTime @default(now())
  giveaway   Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)

  @@unique([giveawayId, kickUserId])
  @@index([giveawayId, createdAt])
}

model GiveawayWidgetConfig {
  id                    String   @id @default(uuid())
  channelSlug           String   @unique
  animationDurationMs   Int      @default(3600)
  confettiEnabled       Boolean  @default(true)
  soundEnabled          Boolean  @default(false)
  showTopParticipants   Boolean  @default(true)
  topParticipantsLimit  Int      @default(5)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Poll {
  id           String     @id @default(uuid())
  channelSlug  String
  question     String
  options      String[]
  durationS    Int        @default(60)
  weightedSubs Boolean    @default(false)
  status       String     @default("open")
  winnerOption Int?
  createdAt    DateTime   @default(now())
  closesAt     DateTime?
  closedAt     DateTime?
  votes        PollVote[]

  @@index([channelSlug, status, createdAt])
}

model PollVote {
  id         String   @id @default(uuid())
  pollId     String
  kickUserId BigInt
  username   String
  option     Int
  weight     Int      @default(1)
  createdAt  DateTime @default(now())
  poll       Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@unique([pollId, kickUserId])
  @@index([pollId, option])
}

// ─── Fase 1/4 — Mini games ───────────────────────────────────────────────────

model Player {
  id         String     @id @default(uuid())
  kickUserId BigInt     @unique
  username   String
  slug       String
  wins       Int        @default(0)
  losses     Int        @default(0)
  draws      Int        @default(0)
  points     Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  asXGames   Game[]     @relation("GamePlayerX")
  asOGames   Game[]     @relation("GamePlayerO")
  wonGames   Game[]     @relation("GameWinner")
  moves      GameMove[]

  @@index([points])
}

model Game {
  id          String     @id @default(uuid())
  gameType    String
  channelSlug String
  playerXId   String
  playerOId   String
  winnerId    String?
  status      String
  boardState  String?
  startedAt   DateTime   @default(now())
  finishedAt  DateTime?
  playerX     Player     @relation("GamePlayerX", fields: [playerXId], references: [id], onDelete: Restrict)
  playerO     Player     @relation("GamePlayerO", fields: [playerOId], references: [id], onDelete: Restrict)
  winner      Player?    @relation("GameWinner", fields: [winnerId], references: [id], onDelete: SetNull)
  moves       GameMove[]

  @@index([channelSlug, status])
  @@index([gameType, startedAt])
}

model GameMove {
  id        String   @id @default(uuid())
  gameId    String
  playerId  String
  position  Int
  createdAt DateTime @default(now())
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@index([gameId])
}
