# ============================================
# RAILWAY ENVIRONMENT VARIABLES TEMPLATE
# ============================================
# Copie estas variáveis para o Railway Dashboard
# ou use: railway variables set NOME=valor

# --- Kick OAuth (OBRIGATÓRIO) ---
KICK_CLIENT_ID=seu_client_id_aqui
KICK_CLIENT_SECRET=seu_client_secret_aqui
KICK_CHANNEL_SLUG=seu_canal_aqui
KICK_BOT_SLUG=seu_bot_slug_aqui
KICK_CHATROOM_ID=id_do_chatroom_aqui

# --- Database (Railway provisiona automaticamente) ---
# DATABASE_URL será injetado automaticamente pelo Railway Postgres Plugin
# REDIS_URL será injetado automaticamente pelo Railway Redis Plugin

# --- API Configuration ---
API_PORT=3001
CORS_ORIGIN=https://seu-frontend.vercel.app
API_JWT_SECRET=seu_jwt_secret_super_seguro_aqui
ADMIN_PASSWORD_HASH=seu_hash_bcrypt_aqui

# URLs do Frontend (ajuste após deploy do frontend)
WEB_PLAY_URL=https://seu-frontend.vercel.app/play
WEB_OVERLAY_URL=https://seu-frontend.vercel.app/overlay
WEB_STORE_URL=https://seu-frontend.vercel.app/store

# --- Tokens Expiry ---
PLAYER_TOKEN_EXPIRY=10m
OVERLAY_TOKEN_EXPIRY=30d
STORE_VIEWER_TOKEN_EXPIRY=7d

# --- Loyalty System ---
LOYALTY_POINTS_PER_ACTIVITY=1
LOYALTY_ACTIVITY_INTERVAL_SECONDS=60

# --- Webhook Configuration ---
# PUBLIC_API_URL será a URL do Railway (ex: https://seu-projeto.railway.app)
PUBLIC_API_URL=https://seu-projeto.railway.app
KICK_WEBHOOK_PATH=/api/kick/webhooks/events
KICK_WEBHOOK_SKIP_VERIFY=false

# --- Giveaway & Polls ---
GIVEAWAY_DEFAULT_FILTER=everyone
POLL_DEFAULT_DURATION_SECONDS=60

# --- Game Configuration (Opcional) ---
GAME_TIMEOUT_MS=300000
COMMAND_COOLDOWN_MS=2000
MAX_ACTIVE_GAMES=1
BOT_MESSAGE_PREFIX=true
RECOVER_GAMES_ON_BOOT=true

# ============================================
# NOTAS:
# - DATABASE_URL e REDIS_URL são injetados automaticamente pelos plugins
# - Para gerar ADMIN_PASSWORD_HASH:
#   node -e "const bcrypt = require('bcryptjs'); bcrypt.hash('sua-senha', 10).then(console.log)"
# ============================================
